<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HairGuru AI | Professional Grooming</title>

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Inter:wght@300;400;700;900&display=swap');

:root {
    --gold: #d4af37;
    --dark-gold: #aa8928;
}

body {
  background: #0a0a0a;
  color: #d1d5db;
  font-family: 'Inter', sans-serif;
  scroll-behavior: smooth;
  overflow-x: hidden;
}

h1, h2, h3, h4 { font-family: 'Cinzel', serif; }

/* Dynamic Mesh Background */
.hero-mesh {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: 
        radial-gradient(at 0% 0%, rgba(212, 175, 55, 0.15) 0, transparent 50%), 
        radial-gradient(at 100% 100%, rgba(212, 175, 55, 0.1) 0, transparent 50%);
    z-index: 0;
}

.text-gradient {
    background: linear-gradient(to bottom, #ffffff 0%, #a1a1a1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* 3D Effects */
.card-3d-wrap { perspective: 1000px; }
.card-3d-inner {
  transition: transform 0.5s cubic-bezier(0.2, 1, 0.3, 1);
  transform-style: preserve-3d;
}
.card-3d-inner:hover { transform: rotateY(8deg) rotateX(4deg); }

.glass {
  background: rgba(20, 20, 20, 0.6);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.05);
  transition: all 0.4s ease;
}

.glass:hover {
    border-color: var(--gold);
    background: rgba(30, 30, 30, 0.8);
}

/* Premium Buttons */
.btn-premium {
    position: relative;
    padding: 1.25rem 2.5rem;
    background: var(--gold);
    color: #000;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.75rem;
    transition: 0.5s;
    overflow: hidden;
    display: inline-block;
}

.btn-premium::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: 0.5s;
}

.btn-premium:hover::before { left: 100%; }
.btn-premium:hover {
    box-shadow: 0 0 30px rgba(212, 175, 55, 0.4);
    transform: scale(1.05);
}

/* Scan Line */
.scan-line {
  position: absolute;
  width: 100%;
  height: 3px;
  background: var(--gold);
  box-shadow: 0 0 15px var(--gold);
  animation: scan 2.5s infinite ease-in-out;
}
@keyframes scan {
  0% { top: 0%; opacity: 0; }
  50% { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

/* Expandable Content */
.tip-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease-out;
}
.glass.active .tip-content {
    max-height: 200px;
    margin-top: 1rem;
}

#routine-display {
    transition: opacity 0.3s ease;
}
</style>
</head>
<body>

<!-- NAVIGATION -->
<header class="flex justify-between items-center px-12 py-8 bg-black/40 backdrop-blur-xl sticky top-0 z-50 border-b border-white/5">
  <h1 class="text-2xl font-black tracking-widest text-white">HAIR<span class="text-[#d4af37]">GURU</span></h1>
  <nav class="hidden md:flex space-x-12 text-[10px] font-bold uppercase tracking-[0.3em]">
    <a href="#features" class="text-gray-400 hover:text-white transition">Services</a>
    <a href="#hair-types" class="text-gray-400 hover:text-white transition">Hair Care</a>
    <a href="#trends" class="text-gray-400 hover:text-white transition">Trending</a>
  </nav>
</header>

<!-- HERO SECTION -->
<section class="relative min-h-[90vh] flex items-center justify-center text-center px-6 overflow-hidden">
  <div class="hero-mesh"></div>
  <div class="relative z-10 max-w-4xl" data-aos="fade-up">
    <span class="text-[var(--gold)] text-[10px] font-black uppercase tracking-[0.5em] mb-4 block">The Future of Grooming</span>
    <h2 class="text-5xl md:text-8xl font-black text-white mb-6 uppercase tracking-tighter leading-none">
      Elevate Your <br> <span class="text-gradient italic">Signature Look</span>
    </h2>
    <p class="text-gray-400 max-w-lg mx-auto mb-12 text-sm font-light tracking-wide">
      Use AI facial mapping to discover the haircut that actually fits your structure.
    </p>
    <button onclick="showUpload()" class="btn-premium">Try Hair Suggestion</button>
  </div>
</section>

<!-- SERVICES -->
<section id="features" class="px-6 py-32 max-w-7xl mx-auto">
  <div class="grid md:grid-cols-4 gap-6">
    <div class="card-3d-wrap" data-aos="fade-up" data-aos-delay="100">
      <div class="card-3d-inner glass p-10 text-center h-full rounded-xl">
        <div class="text-2xl mb-6">✂️</div>
        <h3 class="text-white text-[10px] font-black uppercase tracking-widest mb-3">Hair Suggestion</h3>
        <p class="text-[11px] text-gray-500">Selection based on geometry[cite: 1].</p>
      </div>
    </div>
    <div class="card-3d-wrap" data-aos="fade-up" data-aos-delay="200">
      <div class="card-3d-inner glass p-10 text-center h-full rounded-xl">
        <div class="text-2xl mb-6">🧴</div>
        <h3 class="text-white text-[10px] font-black uppercase tracking-widest mb-3">Hair Care</h3>
        <p class="text-[11px] text-gray-500">Routines for your texture[cite: 1].</p>
      </div>
    </div>
    <div class="card-3d-wrap" data-aos="fade-up" data-aos-delay="300">
      <div class="card-3d-inner glass p-10 text-center h-full rounded-xl">
        <div class="text-2xl mb-6">🧔</div>
        <h3 class="text-white text-[10px] font-black uppercase tracking-widest mb-3">Beard Design</h3>
        <p class="text-[11px] text-gray-500">Sculpting advice for jawlines[cite: 1].</p>
      </div>
    </div>
    <div class="card-3d-wrap" data-aos="fade-up" data-aos-delay="400">
      <div class="card-3d-inner glass p-10 text-center h-full rounded-xl">
        <div class="text-2xl mb-6">👤</div>
        <h3 class="text-white text-[10px] font-black uppercase tracking-widest mb-3">Face Analysis</h3>
        <p class="text-[11px] text-gray-500">Bone structure recognition[cite: 1].</p>
      </div>
    </div>
  </div>
</section>

<!-- HAIR TYPE & ROUTINE SECTION -->
<section id="hair-types" class="px-6 py-24 max-w-6xl mx-auto">
    <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl text-white tracking-widest uppercase mb-2">Hair Care by Type</h2>
        <p class="text-[var(--gold)] text-[10px] font-black uppercase tracking-[0.4em]">Select your texture[cite: 1]</p>
    </div>

    <div class="grid md:grid-cols-3 gap-4 mb-12">
        <button onclick="updateRoutine('straight')" class="glass p-8 group hover:border-[var(--gold)] transition-all duration-500">
            <h3 class="text-white text-xs font-bold tracking-widest uppercase group-hover:text-[var(--gold)]">Straight</h3>
            <div class="w-full h-[1px] bg-white/10 my-4 group-hover:bg-[var(--gold)]"></div>
            <p class="text-[10px] text-gray-500 uppercase tracking-tighter">Smooth & Resilient</p>
        </button>
        <button onclick="updateRoutine('wavy')" class="glass p-8 group hover:border-[var(--gold)] transition-all duration-500">
            <h3 class="text-white text-xs font-bold tracking-widest uppercase group-hover:text-[var(--gold)]">Wavy</h3>
            <div class="w-full h-[1px] bg-white/10 my-4 group-hover:bg-[var(--gold)]"></div>
            <p class="text-[10px] text-gray-500 uppercase tracking-tighter">Volume & Flow</p>
        </button>
        <button onclick="updateRoutine('curly')" class="glass p-8 group hover:border-[var(--gold)] transition-all duration-500">
            <h3 class="text-white text-xs font-bold tracking-widest uppercase group-hover:text-[var(--gold)]">Curly</h3>
            <div class="w-full h-[1px] bg-white/10 my-4 group-hover:bg-[var(--gold)]"></div>
            <p class="text-[10px] text-gray-500 uppercase tracking-tighter">Depth & Texture</p>
        </button>
    </div>

    <div id="routine-display" class="glass p-12 rounded-xl border-l-4 border-[var(--gold)]">
        <div id="routine-content">
            <h4 class="text-white font-black tracking-widest text-sm uppercase mb-6" id="routine-title">Daily Hair Care</h4>
            <div class="grid md:grid-cols-2 gap-8">
                <div>
                    <h5 class="text-[var(--gold)] text-[10px] font-bold uppercase mb-3">The Routine</h5>
                    <ul class="text-[11px] text-gray-400 space-y-3" id="routine-steps">
                        <li>• Click a hair type above to view your grooming routine.</li>
                    </ul>
                </div>
                <div>
                    <h5 class="text-[var(--gold)] text-[10px] font-bold uppercase mb-3">Top Product</h5>
                    <p class="text-[11px] text-gray-400 italic" id="routine-product">Suggestion will appear here.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TRENDING -->
<section id="trends" class="px-6 py-32 bg-[#050505]">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-3xl text-white mb-16 tracking-widest uppercase">Trending Styles</h2>
    <div class="grid md:grid-cols-3 gap-10">
      <div class="group overflow-hidden rounded-xl border border-white/5">
        <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e" class="w-full grayscale group-hover:grayscale-0 group-hover:scale-110 transition duration-1000">
        <div class="p-6 bg-black">
          <h3 class="text-white font-black text-[10px] tracking-widest uppercase">The Executive Fade</h3>
        </div>
      </div>
      <div class="group overflow-hidden rounded-xl border border-white/5">
        <img src="https://images.unsplash.com/photo-1492562080023-ab3db95bfbce" class="w-full grayscale group-hover:grayscale-0 group-hover:scale-110 transition duration-1000">
        <div class="p-6 bg-black">
          <h3 class="text-white font-black text-[10px] tracking-widest uppercase">Modern Crop</h3>
        </div>
      </div>
      <div class="group overflow-hidden rounded-xl border border-white/5">
        <img src="https://images.unsplash.com/photo-1520975916090-3105956dac38" class="w-full grayscale group-hover:grayscale-0 group-hover:scale-110 transition duration-1000">
        <div class="p-6 bg-black">
          <h3 class="text-white font-black text-[10px] tracking-widest uppercase">Urban Quiff</h3>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- UPLOAD & LOADING -->
<section id="uploadSection" class="hidden py-32 px-6 text-center bg-black">
  <div class="max-w-2xl mx-auto glass p-16 rounded-3xl">
    <h3 class="text-white text-xl mb-8 uppercase tracking-[0.3em]">Face Analysis</h3>
    <p class="text-gray-500 text-xs mb-10">Upload a clear photo to begin[cite: 1].</p>
    <input type="file" id="fileInput" class="text-xs text-gray-500 mb-10 block mx-auto">
    <button onclick="analyze()" class="btn-premium">Process Image</button>
  </div>
</section>

<section id="loading" class="hidden py-24 text-center">
  <div class="relative inline-block border border-[var(--gold)] p-4 bg-black">
    <img src="https://via.placeholder.com/400/000/d4af37?text=SCANNING" class="opacity-30 grayscale">
    <div class="scan-line"></div>
  </div>
</section>

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
  AOS.init({ duration: 1000, once: true });

  const routines = {
    straight: {
        title: "Straight Hair Routine",
        steps: ["Wash every 2 days.", "Use volumizing mousse.", "Blow-dry roots up."],
        product: "Volumizing Mousse"
    },
    wavy: {
        title: "Wavy Hair Routine",
        steps: ["Use sulfate-free shampoo.", "Apply sea-salt spray.", "Pat dry gently."],
        product: "Sea Salt Spray"
    },
    curly: {
        title: "Curly Hair Routine",
        steps: ["Wash once a week.", "Deep condition weekly.", "Use curl cream."],
        product: "Curl-Defining Cream"
    }
  };

  function updateRoutine(type) {
    const data = routines[type];
    const display = document.getElementById('routine-display');
    display.style.opacity = '0';
    setTimeout(() => {
        document.getElementById('routine-title').innerText = data.title;
        document.getElementById('routine-product').innerText = data.product;
        document.getElementById('routine-steps').innerHTML = data.steps.map(s => `<li>• ${s}</li>`).join('');
        display.style.opacity = '1';
    }, 300);
  }

  function showUpload(){
    document.getElementById("uploadSection").classList.remove("hidden");
    window.scrollTo({ top: document.getElementById("uploadSection").offsetTop - 50, behavior: 'smooth' });
  }

  function analyze(){
    document.getElementById("uploadSection").classList.add("hidden");
    document.getElementById("loading").classList.remove("hidden");
    setTimeout(() => {
      alert("Analysis Complete! Recommended: The Executive Fade[cite: 1]");
      document.getElementById("loading").classList.add("hidden");
    }, 2500);
  }
</script>

</body>
</html>
